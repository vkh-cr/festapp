{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festapp.net/schemas/private-inputs-v1.json",
  "title": "Festapp private build and deployment input names",
  "description": "Public interface only. Values are supplied explicitly by FestappSeed or an approved secret manager and are never committed here.",
  "type": "object",
  "additionalProperties": false,
  "x-operationRequirements": {
    "supabaseManagement": ["SUPABASE_ACCESS_TOKEN"],
    "databaseAdministration": ["DATABASE_URL"],
    "cloudflareDeploy": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"],
    "r2ImageMigration": ["DATABASE_URL", "CF_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "R2_BUCKET_NAME"],
    "googlePlayRelease": ["GOOGLE_PLAY_JSON_KEY"],
    "appStoreRelease": ["APP_STORE_CONNECT_KEY_ID", "APP_STORE_CONNECT_ISSUER_ID", "APP_STORE_CONNECT_KEY_PATH"],
    "clientSyncPublisherSchedule": ["SUPABASE_ACCESS_TOKEN", "CLIENT_SYNC_PUBLISHER_WAKE_URL", "CLIENT_SYNC_PUBLISHER_WAKE_TOKEN"],
    "clientSyncPrivateLoad": ["FESTAPP_TEST_ACCESS_TOKEN"]
  },
  "properties": {
    "SUPABASE_ACCESS_TOKEN": { "type": "string", "minLength": 1 },
    "SUPABASE_DB_PASSWORD": { "type": "string", "minLength": 1 },
    "SUPABASE_SERVICE_ROLE_KEY": { "type": "string", "minLength": 1 },
    "DATABASE_URL": { "type": "string", "minLength": 1 },
    "CLOUDFLARE_API_TOKEN": { "type": "string", "minLength": 1 },
    "CLOUDFLARE_ACCOUNT_ID": { "type": "string", "minLength": 1 },
    "CF_ACCOUNT_ID": { "type": "string", "minLength": 1 },
    "R2_ACCESS_KEY_ID": { "type": "string", "minLength": 1 },
    "R2_SECRET_ACCESS_KEY": { "type": "string", "minLength": 1 },
    "R2_BUCKET_NAME": { "type": "string", "minLength": 1 },
    "GOOGLE_PLAY_JSON_KEY": { "type": "string", "minLength": 1 },
    "APP_STORE_CONNECT_KEY_ID": { "type": "string", "minLength": 1 },
    "APP_STORE_CONNECT_ISSUER_ID": { "type": "string", "minLength": 1 },
    "APP_STORE_CONNECT_KEY_PATH": { "type": "string", "minLength": 1 },
    "APP_REVIEW_DEMO_PASSWORD": { "type": "string", "minLength": 1 },
    "MATCH_PASSWORD": { "type": "string", "minLength": 1 },
    "CLIENT_SYNC_PUBLISHER_WAKE_TOKEN": { "type": "string", "minLength": 1 },
    "CLIENT_SYNC_PUBLISHER_WAKE_URL": { "type": "string", "minLength": 1 },
    "FESTAPP_TEST_ACCESS_TOKEN": { "type": "string", "minLength": 1 },
    "SMTP_USER_PASSWORD": { "type": "string", "minLength": 1 },
    "QR_RATE_SALT": { "type": "string", "minLength": 1 }
  }
}
