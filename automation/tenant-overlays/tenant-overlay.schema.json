{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festapp.net/schemas/tenant-overlay-v1.json",
  "title": "Festapp production branch overlay metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "baseMainSha"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tenantId": { "enum": ["csmostrava2026", "hvezdamorska"] },
    "baseMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "note": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
